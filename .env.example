# Copy this file to server/.env and client/.env, then fill in real values.
# This root file documents every variable used across the project.

# --- Server ---
NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/lucid-parfums
JWT_SECRET=
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=lucid_token
PASSWORD_RESET_EXPIRES_MIN=60
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
IMAGE_STORAGE_URL=
IMAGE_STORAGE_KEY=
IMAGE_STORAGE_SECRET=
EMAIL_SERVICE_KEY=
PAYMENT_SECRET=

# --- Client (must be prefixed VITE_ to be exposed to the browser) ---
VITE_API_BASE_URL=http://localhost:5000/api
